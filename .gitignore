# Dependencias (se reinstalan con: npm install)
node_modules/

# Front compilado. Se genera con `npm run build` y lo arma solo INICIAR.bat
# la primera vez. No va al repositorio: son ~2 MB de bundles con hash que
# cambian en cada build y ensucian todos los diff.
web-dist/

# ── DATOS DEL TALLER ──────────────────────────────────────────────
# La base se crea sola al arrancar, con los valores de fábrica.
# Nunca subir la base real: tiene clientes, precios y presupuestos.
data/*.db
data/*.db-wal
data/*.db-shm
data/backups/
data/legado/
data/*.json
!data/.gitkeep

# Archivos generados (PDF de presupuestos, DXF para la máquina)
salidas/*
!salidas/.gitkeep

# Muestras que dejan los tests
tests/salida-*.pdf
tests/salida-*.dxf
tests/.tmp-db/

# ── SECRETOS ──────────────────────────────────────────────────────
# Hoy el sistema no usa ninguno: no hay claves de API, ni servicios
# externos, ni login. La única variable de entorno es PORT.
# Esto está por si algún día se agrega (por ejemplo el certificado de
# ARCA para factura electrónica). El repositorio es PÚBLICO: un secreto
# commiteado acá queda expuesto para siempre, aunque después se borre.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
credenciales*.json

# Configuración local de la máquina
.claude/settings.local.json

# Sistema operativo y editores
Thumbs.db
desktop.ini
.DS_Store
*.swp
.vscode/
.idea/

.vercel

# Configuracion del puente a la maquina: lleva la IP del equipo del taller
# y, si se usa, el token de telemetria. Se genera con:
#   npm run puente-maquina -- --ejemplo > puente-maquina.json
puente-maquina.json
